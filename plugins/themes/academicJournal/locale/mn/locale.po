msgstr "Бүрэн эхийг хэлээр"

msgid "plugins.themes.academicJournal.option.galleysByLocale.description"
msgstr "Өгүүлэл хэд хэдэн хэл дээрх PDF файлтай бол уншигч зөвхөн интерфейсийн хэл дээрхийг (байхгүй бол өгүүллийн хэл дээрхийг) харна."

msgid "plugins.themes.academicJournal.option.galleysByLocale.option"
msgstr "Бүрэн эхийг зөвхөн уншигчийн хэлээр харуулах"
