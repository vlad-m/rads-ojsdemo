msgstr "Лицензия"

msgid "plugins.themes.academicJournal.licenseText"
msgstr "Барлық мақалалар Creative Commons Атрибуция 4.0 Халықаралық лицензиясы бойынша ашық қолжетімділікте жарияланады."

msgid "plugins.themes.academicJournal.kicker"
msgstr "Рецензияланатын ашық қолжетімді журнал"

msgid "plugins.themes.academicJournal.submitManuscript"
