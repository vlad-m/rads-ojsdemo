msgid "plugins.themes.academicJournal.option.galleysByLocale.label"
msgstr "Til boʻyicha toʻliq matn"

msgid "plugins.themes.academicJournal.option.galleysByLocale.description"
msgstr "Maqolaning bir nechta tilda PDF fayli boʻlsa, oʻquvchi faqat interfeys tilidagisini (u boʻlmasa — maqola tilidagisini) koʻradi."

