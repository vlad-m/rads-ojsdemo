msgid "plugins.themes.academicJournal.name"
msgstr "Академиялык журнал темасы"

msgid "plugins.themes.academicJournal.description"
msgstr "Илимий журналдар үчүн классикалык, типографиялык тема: серифтүү аталыштар, журналдын миссиясы, статистикасы жана учурдагы чыгарылышы көрсөтүлгөн башкы бет, ошондой эле мазмундуу төмөнкү бөлүк."

msgid "plugins.themes.academicJournal.option.primaryColour.label"
msgstr "Негизги түс"

msgid "plugins.themes.academicJournal.option.primaryColour.description"
msgstr "Жогорку бөлүктө, төмөнкү бөлүктө жана аталыштарда колдонулат. Кочкул түстү тандаңыз."

msgid "plugins.themes.academicJournal.option.accentColour.label"
msgstr "Басым түсү"

msgid "plugins.themes.academicJournal.option.accentColour.description"
msgstr "Шилтемелерде, баскычтарда жана бөлүнүп көрсөтүлгөн элементтерде колдонулат."

msgid "plugins.themes.academicJournal.option.showHero.label"
msgstr "Башкы беттеги киришүү"

msgid "plugins.themes.academicJournal.option.showHero.option"
msgstr "Журналдын миссиясы жана аракетке чакыруулар менен киришүү блогун көрсөтүү"

msgid "plugins.themes.academicJournal.option.heroTagline.label"
msgstr "Башкы беттеги ураан"

msgid "plugins.themes.academicJournal.option.heroTagline.description"
msgstr "Башкы беттеги киришүүдө көрсөтүлүүчү кыска миссия билдирүүсү. Бош болсо, журналдын кыскача баяндамасынын башы колдонулат."

msgid "plugins.themes.academicJournal.option.showJournalStats.label"
