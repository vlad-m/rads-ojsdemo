msgid "emails.userRoleAssignmentInvitationNotify.body"
msgstr "<div class='email-container'>    <div class='email-header'>        <h2>Приглашение на новую роль</h2>    </div>    <div class='email-content'>        <p>Здравствуйте, {$recipientName}!</p>        <p>Учитывая ваш опыт, {$inviterName} приглашает вас на новые роли в {$contextName}</p>        <p>В {$contextName} мы ценим вашу конфиденциальность. Поэтому мы приняли меры для полного соответствия требованиям GDPR. В частности, вы сами вводите свои данные и выбираете, кто и какую информацию может видеть. Подробнее о том, как мы обрабатываем ваши данные, см. в нашей Политике конфиденциальности.</p>        <div>{$existingRoles}</div>        <div>{$rolesAdded}</div>        <p>После принятия приглашения вы будете перенаправлены в {$contextName}.</p>        <p>Если у вас есть вопросы о процессе, пожалуйста, свяжитесь со мной.</p>        <p><a href='{$acceptUrl}' class='btn btn-accept'>Принять приглашение</a></p>        <p><a href='{$declineUrl}' class='btn btn-decline'>Отклонить приглашение</a></p>        <p>С уважением,</p>        <p>{$contextName}</p>    </div></div><style>{$emailTemplateStyle}</style>"

msgid "emails.userRoleAssignmentInvitationNotify.userGroupSection"
msgstr "<div class='section'>    <div class='section-number'>{$sectionNumber}.</div>    <div class='section-content'>        <h2>{$sectionName}</h2>        <p>Начиная с {$dateStart}</p>        <p>{$sectionEndingDate}</p>        <p>{$sectionMastheadAppear}</p>    </div></div>"

