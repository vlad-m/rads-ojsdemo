msgid "mailable.userRoleEndNotify.description"
msgstr "Уведомление по электронной почте, отправляемое пользователю, когда его снимают с роли."

msgid "emails.userRoleEndNotify.subject"
msgstr "Вы сняты с роли"

msgid "emails.userRoleEndNotify.body"
msgstr "<div class='email-container'>    <div class='email-header'>        <h2>Снятие с роли</h2>    </div>    <div class='email-content'>        <p>Здравствуйте, {$recipientName}!</p>        <p>Большое спасибо за ваше участие в роли «{$roleRemoved}» в {$contextName}.</p>        <p>Сообщаем, что вы сняты со следующей роли в {$contextName}: <b>{$roleRemoved}</b>.</p>        <p>Ваша учетная запись в {$contextName} по-прежнему активна, как и все другие роли, которые у вас были ранее.</p>        <p>Если у вас есть вопросы о процессе, пожалуйста, свяжитесь со мной.</p>        <p>С уважением,</p>        <p>{$contextName}</p>    </div></div><style>{$emailTemplateStyle}</style>"

