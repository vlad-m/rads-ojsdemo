msgid "plugins.generic.demoMode.displayName"
msgstr "Demo rejimi"

msgid "plugins.generic.demoMode.description"
msgstr "Faqat o'qish uchun namoyish rejimi: demo hisoblar barcha sahifa va shakllarni ochishi mumkin, ammo o'zgarishlar hech qachon saqlanmaydi. config.inc.php faylidan ([demo] bo'limi) boshqariladi."

