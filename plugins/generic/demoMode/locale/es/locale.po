msgid "plugins.generic.demoMode.banner.superuser"
msgstr "El modo de demostración está activado, pero ha iniciado sesión como superusuario: sus cambios SÍ se guardan."

msgid "plugins.generic.demoMode.login.title"
msgstr "Cuentas de demostración"

