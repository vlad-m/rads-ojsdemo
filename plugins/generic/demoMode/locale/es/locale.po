msgid "plugins.generic.demoMode.displayName"
msgstr "Modo de demostración"

msgid "plugins.generic.demoMode.description"
msgstr "Modo de demostración de solo lectura: las cuentas de demostración pueden abrir todas las páginas y formularios, pero los cambios nunca se guardan. Se controla desde config.inc.php (sección [demo])."

msgid "plugins.generic.demoMode.title"
msgstr "Modo de demostración"

msgid "plugins.generic.demoMode.refused"
msgstr "Esta es una instalación de demostración: los cambios no se guardan. Puede explorar todas las páginas y formularios, pero guardar, subir archivos y enviar correos electrónicos están desactivados."

msgid "plugins.generic.demoMode.back"
msgstr "Volver"

