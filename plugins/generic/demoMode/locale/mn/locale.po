msgid "plugins.generic.demoMode.displayName"
msgstr "Демо горим"

msgid "plugins.generic.demoMode.description"
msgstr "Зөвхөн унших боломжтой демо горим: демо бүртгэлүүд бүх хуудас, маягтыг нээж болох боловч өөрчлөлт хадгалагдахгүй. config.inc.php ([demo] хэсэг)-ээс удирдана."

msgid "plugins.generic.demoMode.title"
msgstr "Демо горим"

msgid "plugins.generic.demoMode.refused"
msgstr "Энэ бол демо суулгац: өөрчлөлт хадгалагдахгүй. Бүх хуудас, маягтыг үзэж болох ч хадгалах, файл байршуулах, имэйл илгээх боломжгүй."

msgid "plugins.generic.demoMode.back"
msgstr "Буцах"

msgid "plugins.generic.demoMode.banner"
msgstr "Демо горим — чөлөөтэй судлаарай, өөрчлөлт хадгалагдахгүй."

msgid "plugins.generic.demoMode.banner.reset"
msgstr "Демо өгөгдлийг {$hours} цаг тутамд сэргээдэг."

msgid "plugins.generic.demoMode.banner.superuser"
msgstr "Демо горим идэвхтэй боловч та супер хэрэглэгчээр нэвтэрсэн: таны өөрчлөлт ХАДГАЛАГДАНА."

